# MySQL Database Configuration
# Copy this file to db.properties and set your MySQL username and password.
# Alternatively, you can configure these settings via Environment Variables:
#   DB_URL, DB_USER, DB_PASSWORD

db.url=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=root
db.password=your_mysql_password_here
